# Enterprise Intelligence Copilot — Environment Variables
# Copy this to .env and fill in your values

# ─── LLM (Groq — free, OpenAI-compatible) ───────────────────────────────────
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative models available on Groq free tier:
# GROQ_MODEL=openai/gpt-oss-20b        # faster, smaller (20B params)
# GROQ_MODEL=qwen/qwen3.8-27b          # Qwen 27B

# ─── Qdrant Vector DB ─────────────────────────────────────────────────────────
# Set to true for in-memory mode (no server needed — recommended for MVP)
QDRANT_USE_MEMORY=true

# Set to false and configure below to use a running Qdrant server
# QDRANT_USE_MEMORY=false
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ─── Embedding Model (runs locally, no API key needed) ───────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
